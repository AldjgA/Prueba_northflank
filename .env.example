# --- Secretos (los mismos que ya tienes en Northflank) --------------------
# clave1: CLAVE DE SERVICIO. Protege el mini-backend y los endpoints de
#         administracion (cabecera X-API-Key o Authorization: Bearer).
#         Usala en tus scripts y en llamadas servidor-a-servidor.
#         No tiene cuota propia: solo cuenta para el tope global.
#         Si la dejas vacia, el servicio queda ABIERTO (con aviso en los logs).
clave1=cambia-esto-por-un-token-largo-y-aleatorio

# clave2: API key de Gemini.
clave2=tu-api-key-de-google-ai-studio

# clave3: DSN de Postgres (Supabase). Ademas de las conversaciones, aqui viven
#         las claves de tester y el consumo. Si lo dejas vacio, el backend
#         arranca igual pero sin persistencia ni claves de tester.
#         Puerto 6543 = transaction pooler (recomendado):
#         postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
clave3=postgresql://postgres.xxxxxxxx:PON-LA-PASSWORD-REAL-AQUI@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# --- Cuotas --------------------------------------------------------------
# Techo de peticiones al dia para TODO el servicio. Es la red de seguridad:
# aunque la autenticacion falle o alguien abuse, el gasto tiene un limite.
# 0 = sin tope.
GLOBAL_DAILY_CAP=2000

# Cuota diaria que se asigna a una clave nueva si no indicas otra cosa.
DEFAULT_DAILY_QUOTA=100

# --- Gemini --------------------------------------------------------------
MODEL_ID=gemini-3.5-flash-lite
MAX_OUTPUT_TOKENS=1024
MAX_INPUT_CHARS=8000
MAX_HISTORY_TURNS=20
TEMPERATURE=0.7
MAX_RETRIES=2
REQUEST_TIMEOUT_S=60
SYSTEM_PROMPT=

# --- Concurrencia --------------------------------------------------------
# MAX_CONCURRENCY = peticiones a Gemini EN VUELO a la vez. No limita las
# conexiones HTTP: Go atiende miles. Con ~15 testers, sube a 8-10.
MAX_CONCURRENCY=3

# Cuanto espera en cola una peticion antes de recibir un 503.
QUEUE_TIMEOUT_S=30

# Peticiones por minuto y por IP.
RATE_LIMIT_PER_MIN=60

# --- Base de datos -------------------------------------------------------
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_LIFETIME_S=30
DB_QUERY_TIMEOUT_S=10
DB_CONNECT_TIMEOUT_S=10
DB_CONNECT_RETRIES=3
AUTO_MIGRATE=true
HISTORY_LIMIT=50

# --- Servidor ------------------------------------------------------------
ADDR=:8080
LOG_LEVEL=INFO
